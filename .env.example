# Copy this file to .env.local and fill in your Supabase project values.
# In Supabase: Project Settings → API → Project URL and Project API keys (anon / public).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Passphrase for the /results page. Note: VITE_* env vars are bundled into the
# client JS, so this is *soft gating* only — anyone with the bundle can read it.
# Treat it as a friction barrier, not real auth.
VITE_RESULTS_PASSPHRASE=changeme
